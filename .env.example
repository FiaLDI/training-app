# Copy to .env:  cp .env.example .env
# Then:          npm run up

# --- Docker images (CI/CD) ---
# Local default: "local" (docker compose up --build tags images as workout-*:local)
# Production: set by Jenkins deploy to the BUILD_NUMBER of the released images
IMAGE_TAG=local

# --- App (nginx) ---
# Open http://localhost:$APP_PORT  (and https://localhost:$HTTPS_PORT)
APP_PORT=80
HTTPS_PORT=443

# --- HTTPS / Let's Encrypt (IP certificate, ~6 days) ---
# Public IPv4 of this server (required for: npm run ssl:issue)
# CERTBOT_IP=203.0.113.10
# Optional — without it certbot registers with --register-unsafely-without-email
# CERTBOT_EMAIL=you@example.com

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=workout
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/workout

# --- Redis (cache / shared state) ---
# Used for: user cache in AuthGuard, JWT revocation, rate-limit counters.
# Optional — if unset, the backend falls back to an in-memory store (single
# instance only). docker-compose overrides this with redis://redis:6379.
REDIS_URL=redis://localhost:6379
# Alternative to REDIS_URL: REDIS_HOST / REDIS_PORT / REDIS_PASSWORD
# Max memory for the Redis container (keys are evicted LRU beyond this).
REDIS_MAXMEMORY=256mb

# --- Backend ---
PORT=3000
JWT_SECRET=dev-secret-change-me
# Pepper for HMAC login-code lookup. Optional: if unset, falls back to JWT_SECRET
# (same rule as the HashLoginCodes migration). Rotating it invalidates every
# login_code_lookup — all users need a code reset. Prefer leaving unset unless
# you intentionally separate it from JWT_SECRET.
# LOGIN_CODE_PEPPER=
# How long a user profile stays cached. Also the worst-case delay for a role
# change to take effect when invalidation is missed.
AUTH_USER_CACHE_TTL_SECONDS=300

# --- Upload service ---
# Max file size in bytes (default 5 MiB) and max files in ./upload (default 100).
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_FILES=100
# Local upload-service port (do not reuse backend PORT=3000)
UPLOAD_PORT=3002
# Local upload-service → API (docker-compose sets http://backend:3000)
BACKEND_URL=http://127.0.0.1:3000

# --- Frontend (local next dev only; Docker build uses /api) ---
NEXT_PUBLIC_API_URL=/api
API_PROXY_TARGET=http://127.0.0.1:3000
UPLOAD_PROXY_TARGET=http://127.0.0.1:3002
