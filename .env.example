# Copy to .env:  cp .env.example .env
# Then:          npm run up

# --- Docker images (CI/CD) ---
# Local default: "local" (docker compose up --build tags images as workout-*:local)
# Production: set by Jenkins deploy to the BUILD_NUMBER of the released images
IMAGE_TAG=local

# --- App (nginx) ---
# Open http://localhost:$APP_PORT  (and https://localhost:$HTTPS_PORT)
APP_PORT=80
HTTPS_PORT=443

# --- HTTPS / Let's Encrypt (IP certificate, ~6 days) ---
# Public IPv4 of this server (required for: npm run ssl:issue)
# CERTBOT_IP=203.0.113.10
# Optional — without it certbot registers with --register-unsafely-without-email
# CERTBOT_EMAIL=you@example.com

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=workout
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/workout

# --- Backend ---
PORT=3000
JWT_SECRET=dev-secret-change-me

# --- Upload service ---
# Max file size in bytes (default 5 MiB) and max files in ./upload (default 100).
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_FILES=100
# Local upload-service port (do not reuse backend PORT=3000)
UPLOAD_PORT=3002
# Local upload-service → API (docker-compose sets http://backend:3000)
BACKEND_URL=http://127.0.0.1:3000

# --- Frontend (local next dev only; Docker build uses /api) ---
NEXT_PUBLIC_API_URL=/api
API_PROXY_TARGET=http://127.0.0.1:3000
UPLOAD_PROXY_TARGET=http://127.0.0.1:3002
